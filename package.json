{
	"name": "vscode-html-to-css",
	"displayName": "HTML to CSS / LESS / SCSS",
	"description": "Copy HTML code and paste it as CSS / LESS / SCSS selectors code",
	"version": "1.2.0",
	"publisher": "tautvydasderzinskas",
	"icon": "images/html2css_transparent.png",
	"author": {
		"name": "Tautvydas Derzinskas",
		"email": "tautvydasuk@gmail.com",
		"url": "https://www.tautvydas.info"
	},
	"galleryBanner": {
		"color": "#313944",
		"theme": "dark"
	},
	"keywords": [
		"html",
		"css",
		"less",
		"scss",
		"html to css",
		"html to less",
		"html to scss"
	],
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"lint": "eslint . --ext ts",
		"test": "jest",
		"test:coverage": "jest --coverage",
		"test:watch": "jest --watch",
		"pretest": "npm run lint",
		"semantic-release": "semantic-release",
		"prepare": "husky install"
	},
	"devDependencies": {
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/github": "^9.2.6",
		"@types/jest": "^29.5.12",
		"@types/jsdom": "^21.1.6",
		"@types/node": "^20.11.19",
		"@types/vscode": "^1.85.0",
		"@typescript-eslint/eslint-plugin": "^7.0.1",
		"@typescript-eslint/parser": "^7.0.1",
		"@vscode/test-electron": "^2.3.9",
		"babel-jest": "^29.7.0",
		"commitizen": "^4.3.0",
		"cz-customizable": "^7.0.0",
		"eslint": "^8.56.0",
		"husky": "^9.0.11",
		"jest": "^29.7.0",
		"jest-environment-jsdom": "^29.7.0",
		"prettier": "^3.2.5",
		"semantic-release": "^23.0.2",
		"ts-jest": "^29.1.2",
		"typescript": "^5.3.3"
	},
	"dependencies": {
		"jsdom": "^24.0.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/SlimDogs/vscode-html-to-css.git"
	},
	"bugs": {
		"url": "https://github.com/SlimDogs/vscode-html-to-css/issues",
		"email": "tautvydasuk+vscode@gmail.com"
	},
	"license": "MIT",
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": [
		"Other",
		"Formatters"
	],
	"activationEvents": [
		"onCommand:htmlToCss.paste"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "htmlToCss.paste",
				"title": "Paste HTML converted to CSS / LESS / SCSS",
				"category": "HTML to CSS"
			}
		],
		"keybindings": [
			{
				"command": "htmlToCss.paste",
				"key": "ctrl+alt+v",
				"mac": "cmd+alt+v",
				"when": "editorTextFocus && !editorReadOnly"
			}
		],
		"menus": {
			"editor/context": [
				{
					"command": "htmlToCss.paste",
					"group": "htmlToCss@1"
				}
			]
		},
		"configuration": {
			"type": "object",
			"title": "HTML to CSS / LESS / SCSS configuration",
			"properties": {
				"htmlToCss.hideTags": {
					"type": "boolean",
					"default": true,
					"description": "Hide tag selector if element has class or id."
				},
				"htmlToCss.convertBEM": {
					"type": "boolean",
					"default": true,
					"description": "Recognize BEM classes and split them accordingly."
				},
				"htmlToCss.preappendHtml": {
					"type": "boolean",
					"default": false,
					"description": "Pre-append comment containing transformed html structure."
				}
			}
		},
		"languages": [
			{
				"id": "css",
				"extensions": [".css"]
			},
			{
				"id": "less",
				"extensions": [".less"]
			},
			{
				"id": "scss",
				"extensions": [".scss", ".sass"]
			}
		]
	},
	"config": {
		"commitizen": {
			"path": "node_modules/cz-customizable"
		},
		"cz-customizable": {
			"config": "config/cz-customizable/base.js"
		}
	},
	"release": {
		"verifyConditions": [
			"@semantic-release/github"
		],
		"prepare": [
			{
				"path": "@semantic-release/changelog",
				"changelogFile": "CHANGELOG.md"
			},
			"@semantic-release/git"
		],
		"publish": [
			"@semantic-release/github"
		]
	}
}
