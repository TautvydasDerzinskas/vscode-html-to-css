{
  "name": "vscode-html-to-css",
  "displayName": "HTML to CSS / LESS / SCSS",
  "description": "Turn HTML, JSX/React, Vue or Twig markup into CSS / LESS / SCSS selectors, and CSS / SCSS / LESS back into HTML or JSX",
  "version": "1.7.1",
  "publisher": "tautvydasderzinskas",
  "icon": "images/icon.png",
  "author": {
    "name": "Tautvydas Derzinskas",
    "email": "tautvydasuk@gmail.com",
    "url": "https://github.com/TautvydasDerzinskas"
  },
  "galleryBanner": {
    "color": "#1e1b4b",
    "theme": "dark"
  },
  "keywords": [
    "html",
    "css",
    "less",
    "scss",
    "sass",
    "react",
    "jsx",
    "tsx",
    "nextjs",
    "classname",
    "twig",
    "jinja",
    "nunjucks",
    "liquid",
    "handlebars",
    "template",
    "html to css",
    "jsx to css",
    "react to css",
    "twig to css",
    "css to html",
    "scss to html",
    "less to html"
  ],
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p ./tsconfig.json && tsc --noEmit -p ./web/tsconfig.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "web:build": "node web/build.mjs",
    "web:serve": "node web/build.mjs --serve",
    "images": "node scripts/generate-images.mjs",
    "wiki": "node scripts/generate-wiki.mjs",
    "package": "vsce package",
    "commit": "cz",
    "semantic-release": "semantic-release",
    "prepare": "husky"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@types/node": "^22.18.0",
    "@types/postcss-less": "^4.0.7",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^4.0.0",
    "commitizen": "^4.3.2",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "cz-customizable": "^7.4.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "node-html-parser": "^9.0.4",
    "oxlint": "^1.83.0",
    "postcss": "^8.5.28",
    "postcss-less": "^6.0.0",
    "postcss-scss": "^4.0.9",
    "postcss-selector-parser": "^7.1.6",
    "prettier": "^3.6.2",
    "semantic-release": "^25.0.9",
    "semantic-release-vsce": "^6.1.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "homepage": "https://tautvydasderzinskas.github.io/vscode-html-to-css/",
  "repository": {
    "type": "git",
    "url": "https://github.com/TautvydasDerzinskas/vscode-html-to-css.git"
  },
  "bugs": {
    "url": "https://github.com/TautvydasDerzinskas/vscode-html-to-css/issues",
    "email": "tautvydasuk+vscode@gmail.com"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0",
    "node": ">=22.14.0"
  },
  "categories": [
    "Other",
    "Formatters"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "htmlToCss.paste",
        "title": "Paste HTML as Selectors (Match File Type)",
        "category": "HTML to CSS",
        "enablement": "!editorReadOnly && (editorLangId =~ /^(css|postcss|less|scss|sass)$/ || resourceExtname =~ /^\\.(css|less|scss|sass)$/i)"
      },
      {
        "command": "htmlToCss.pasteAsCss",
        "title": "Paste HTML as CSS Selectors",
        "category": "HTML to CSS",
        "enablement": "!editorReadOnly"
      },
      {
        "command": "htmlToCss.pasteAsNested",
        "title": "Paste HTML as Nested SCSS / LESS Selectors",
        "category": "HTML to CSS",
        "enablement": "!editorReadOnly"
      },
      {
        "command": "htmlToCss.copyAsCss",
        "title": "Copy as CSS Selectors",
        "category": "HTML to CSS",
        "enablement": "htmlToCss.selectionHasHtml"
      },
      {
        "command": "htmlToCss.copyAsNested",
        "title": "Copy as Nested SCSS / LESS Selectors",
        "category": "HTML to CSS",
        "enablement": "htmlToCss.selectionHasHtml"
      },
      {
        "command": "htmlToCss.copyAsHtml",
        "title": "Copy as HTML",
        "category": "HTML to CSS",
        "enablement": "htmlToCss.selectionHasCss"
      },
      {
        "command": "htmlToCss.pasteAsHtml",
        "title": "Paste as HTML",
        "category": "HTML to CSS",
        "enablement": "!editorReadOnly"
      }
    ],
    "keybindings": [
      {
        "command": "htmlToCss.paste",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v",
        "when": "editorTextFocus && !editorReadOnly"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "htmlToCss.copyAsCss",
          "when": "htmlToCss.selectionHasHtml",
          "group": "9_cutcopypaste@2.1"
        },
        {
          "command": "htmlToCss.copyAsNested",
          "when": "htmlToCss.selectionHasHtml",
          "group": "9_cutcopypaste@2.2"
        },
        {
          "command": "htmlToCss.copyAsHtml",
          "when": "htmlToCss.selectionHasCss",
          "group": "9_cutcopypaste@2.3"
        },
        {
          "command": "htmlToCss.paste",
          "when": "htmlToCss.clipboardHasHtml && (editorLangId =~ /^(css|postcss|less|scss|sass)$/ || resourceExtname =~ /^\\.(css|less|scss|sass)$/i)",
          "group": "htmlToCss@1"
        },
        {
          "command": "htmlToCss.pasteAsCss",
          "when": "htmlToCss.clipboardHasHtml",
          "group": "htmlToCss@2"
        },
        {
          "command": "htmlToCss.pasteAsNested",
          "when": "htmlToCss.clipboardHasHtml",
          "group": "htmlToCss@3"
        },
        {
          "command": "htmlToCss.pasteAsHtml",
          "when": "htmlToCss.clipboardHasCss",
          "group": "htmlToCss@4"
        }
      ]
    },
    "configuration": [
      {
        "title": "HTML → CSS / LESS / SCSS",
        "properties": {
          "htmlToCss.hideTags": {
            "type": "boolean",
            "default": true,
            "description": "Hide tag selector if element has class or id."
          },
          "htmlToCss.convertBEM": {
            "type": "boolean",
            "default": true,
            "description": "Recognize BEM classes and split them accordingly."
          },
          "htmlToCss.reduceSiblings": {
            "type": "boolean",
            "default": true,
            "description": "Collapse duplicate sibling elements that produce the same selector."
          },
          "htmlToCss.combineParents": {
            "type": "boolean",
            "default": true,
            "description": "Merge duplicate sibling elements that have children, combining their children."
          },
          "htmlToCss.preappendHtml": {
            "type": "boolean",
            "default": false,
            "description": "Pre-append comment containing transformed html structure."
          },
          "htmlToCss.classesOnly": {
            "type": "boolean",
            "default": false,
            "description": "Generate class selectors only. Tag and id selectors are never emitted; elements without a class are skipped and their children move up."
          },
          "htmlToCss.ignoredSelectors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "markdownDescription": "Selectors that are never generated, such as utility classes. Supports class (`.container`), id (`#app`) and tag (`p`) selectors, e.g. `[\".container\", \".text-center\", \"p\"]`."
          }
        }
      },
      {
        "title": "CSS / LESS / SCSS → HTML",
        "properties": {
          "htmlToCss.guessTagNames": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "Guess tags from class names when converting CSS to HTML, e.g. `.card__link` becomes `<a>`, `.card__title` becomes `<h2>` and children of `ul` become `<li>`. When off, only tags written in the selectors are used."
          },
          "htmlToCss.defaultTagName": {
            "type": "string",
            "default": "div",
            "pattern": "^[a-zA-Z][a-zA-Z0-9-]*$",
            "patternErrorMessage": "Use a plain tag name, such as div or section.",
            "markdownDescription": "The tag used when converting CSS to HTML for an element whose selector names no tag (and no tag is guessed)."
          }
        }
      }
    ]
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": "config/cz-customizable/base.js"
    }
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits",
          "releaseRules": [
            {
              "scope": "web",
              "release": false
            }
          ]
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits"
        }
      ],
      [
        "@semantic-release/changelog",
        {
          "changelogFile": "CHANGELOG.md"
        }
      ],
      [
        "semantic-release-vsce",
        {
          "packageVsix": true
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "package-lock.json",
            "CHANGELOG.md"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ],
      [
        "@semantic-release/github",
        {
          "assets": [
            {
              "path": "*.vsix",
              "label": "Extension package (.vsix)"
            }
          ]
        }
      ]
    ]
  }
}
