{
  "name": "vscode-html-to-css",
  "displayName": "HTML to CSS / LESS / SCSS",
  "description": "Copy HTML, JSX/React or Twig markup and paste it as CSS / LESS / SCSS selectors code",
  "version": "1.3.0",
  "publisher": "tautvydasderzinskas",
  "icon": "images/html2css_transparent.png",
  "author": {
    "name": "Tautvydas Derzinskas",
    "email": "tautvydasuk@gmail.com",
    "url": "https://www.tautvydas.info"
  },
  "galleryBanner": {
    "color": "#313944",
    "theme": "dark"
  },
  "keywords": [
    "html",
    "css",
    "less",
    "scss",
    "sass",
    "react",
    "jsx",
    "tsx",
    "nextjs",
    "classname",
    "twig",
    "jinja",
    "nunjucks",
    "liquid",
    "handlebars",
    "template",
    "html to css",
    "jsx to css",
    "react to css",
    "twig to css"
  ],
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "vsce package",
    "commit": "cz",
    "semantic-release": "semantic-release",
    "prepare": "husky"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@types/node": "^22.18.0",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^4.0.0",
    "commitizen": "^4.3.2",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "cz-customizable": "^7.4.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "node-html-parser": "^9.0.4",
    "oxlint": "^1.83.0",
    "prettier": "^3.6.2",
    "semantic-release": "^25.0.9",
    "semantic-release-vsce": "^6.1.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TautvydasDerzinskas/vscode-html-to-css.git"
  },
  "bugs": {
    "url": "https://github.com/TautvydasDerzinskas/vscode-html-to-css/issues",
    "email": "tautvydasuk+vscode@gmail.com"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0",
    "node": ">=22.14.0"
  },
  "categories": [
    "Other",
    "Formatters"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "htmlToCss.paste",
        "title": "Paste HTML converted to CSS / LESS / SCSS",
        "category": "HTML to CSS"
      }
    ],
    "keybindings": [
      {
        "command": "htmlToCss.paste",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v",
        "when": "editorTextFocus && !editorReadOnly"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "htmlToCss.paste",
          "group": "htmlToCss@1"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "HTML to CSS / LESS / SCSS configuration",
      "properties": {
        "htmlToCss.hideTags": {
          "type": "boolean",
          "default": true,
          "description": "Hide tag selector if element has class or id."
        },
        "htmlToCss.convertBEM": {
          "type": "boolean",
          "default": true,
          "description": "Recognize BEM classes and split them accordingly."
        },
        "htmlToCss.reduceSiblings": {
          "type": "boolean",
          "default": true,
          "description": "Collapse duplicate sibling elements that produce the same selector."
        },
        "htmlToCss.combineParents": {
          "type": "boolean",
          "default": true,
          "description": "Merge duplicate sibling elements that have children, combining their children."
        },
        "htmlToCss.preappendHtml": {
          "type": "boolean",
          "default": false,
          "description": "Pre-append comment containing transformed html structure."
        }
      }
    }
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": "config/cz-customizable/base.js"
    }
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits"
        }
      ],
      [
        "@semantic-release/changelog",
        {
          "changelogFile": "CHANGELOG.md"
        }
      ],
      [
        "semantic-release-vsce",
        {
          "packageVsix": true
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "package-lock.json",
            "CHANGELOG.md"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ],
      [
        "@semantic-release/github",
        {
          "assets": [
            {
              "path": "*.vsix",
              "label": "Extension package (.vsix)"
            }
          ]
        }
      ]
    ]
  }
}